{
  "name": "sharecropr",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src app --max-warnings 0",
    "postinstall": "patch-package",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "bash scripts/run-pgtap.sh",
    "ci:assert-negative-ratio": "bash scripts/ci-assert-negative-ratio.sh",
    "ci:assert-rls": "bash scripts/ci-assert-rls.sh",
    "ci:assert-no-private-grants": "bash scripts/ci-assert-no-private-grants.sh",
    "ci:assert-definer-allowlist": "bash scripts/ci-assert-definer-allowlist.sh",
    "location-canary": "npm run build --prefix packages/location-canary && npm run check --prefix packages/location-canary"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.3.6",
    "expo": "~57.0.11",
    "expo-dev-client": "~57.0.14",
    "expo-location": "~57.0.8",
    "expo-router": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "supercluster": "^8.0.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "~19.2.2",
    "@types/supercluster": "^7.1.3",
    "babel-preset-expo": "~57.0.7",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.4"
  }
}
